{
    "name": "mapo-89/laravel-avatar-manager",
    "description": "Simple Laravel package to serve avatars by email hash",
    "keywords": [
        "php",
        "laravel",
        "avatar",
        "gravatar"
    ],
    "homepage": "https://github.com/mapo-89/laravel-avatar-manager",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Manuel Postler",
            "email": "info@postler.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0|^13.0",
        "spatie/laravel-medialibrary": "^11.22"
    },
    "autoload": {
        "psr-4": {
            "Mapo89\\LaravelAvatarManager\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mapo89\\LaravelAvatarManager\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "check-composer": "@composer validate --strict",
        "check-autoload": "@composer dump-autoload --optimize --strict-psr --no-scripts",
        "check-style": "pint --test",
        "format": "pint",
        "qa": [
            "@check-composer",
            "@check-autoload",
            "@check-style",
            "@test",
            "@composer audit"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Mapo89\\LaravelAvatarManager\\AvatarManagerServiceProvider"
            ],
            "aliases": {
                "LaravelAvatarManager": "Mapo89\\LaravelAvatarManager\\Facades\\AvatarManager"
            }
        }
    },
    "suggest": {
        "spatie/laravel-medialibrary": "Resolve managed avatar images from CorePanel or other Spatie Media Library hosts."
    }
}
